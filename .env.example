# No credentials are required for the default demo.
APP_MODE=demo
OTEL_CAPTURE_CONTENT=false
OTEL_TRACES_EXPORTER=none
# Live mode uses a single trusted operator identity per deployment.
# Place a user-authenticating gateway in front of it for multi-user use.
API_TOKEN=
ADMIN_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DATABASE_URL=postgresql://genai:local-development-only@localhost:5432/telecom_genai
KNOWLEDGE_VERSION=tickets-v1
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_REDIS_URL=redis://localhost:6379/0
REQUEST_TIMEOUT_SECONDS=45
MAX_CONCURRENT_REQUESTS=4
REQUESTS_PER_MINUTE=30
CONVERSATION_RETENTION_DAYS=30
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=1536
# JSON list, for example ["https://ops.example.com"]
CORS_ORIGINS=[]
