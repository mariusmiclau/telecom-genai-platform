# No credentials are required for the default demo.
APP_MODE=demo
OTEL_CAPTURE_CONTENT=false
OTEL_TRACES_EXPORTER=none
# Bearer mode is one trusted operator. Use OIDC for distinct identities/ACLs.
AUTH_MODE=bearer
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
ENABLE_LOCAL_ACTIONS=false
RETRIEVAL_CONFIGURATION=C
SOURCE_REVIEW_MAX_AGE_DAYS=365
MAX_PENDING_INGESTION_JOBS=20
API_TOKEN=
ADMIN_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DATABASE_URL=postgresql://genai:local-development-only@localhost:5432/telecom_genai
KNOWLEDGE_VERSION=tickets-v1
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_REDIS_URL=redis://localhost:6379/0
REQUEST_TIMEOUT_SECONDS=45
MAX_CONCURRENT_REQUESTS=4
REQUESTS_PER_MINUTE=30
CONVERSATION_RETENTION_DAYS=30
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=1536
# JSON list, for example ["https://ops.example.com"]
CORS_ORIGINS=[]
MAX_REQUEST_TOKENS=24000
MAX_PROMPT_TOKENS=16000
MAX_OUTPUT_TOKENS=1024
MAX_HISTORY_TOKENS=2000
MODEL_RETRY_BUDGET=0
ANSWER_RETENTION_DAYS=30
