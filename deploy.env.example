# Non-secret settings only. Keep each accepted version for rollback.
# APP_IMAGE must be the digest produced by the manual image publication workflow.
APP_IMAGE=
DOMAIN=
KNOWLEDGE_VERSION=tickets-v1
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CONVERSATION_RETENTION_DAYS=30
SECRETS_DIR=./.secrets
DATASET_PATH=./datasets/tickets-v2.0-ticket-aware-chunking
# Use otlp with an approved private collector; query content stays disabled.
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
